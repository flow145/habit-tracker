  "repository": "git@github.com:flow145/habit-tracker.git",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --reporter=summary",
    "format:fix": "pnpm format --write",
    "check": "biome check --reporter=summary",
    "check:fix": "pnpm check --write",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "~1.9.0",
    "@fontsource-variable/geist": "~5.3.0",
    "@tanstack/react-virtual": "~3.14.24",
    "clsx": "~2.1.1",
    "date-fns": "~4.4.0",
    "i18next": "~26.6.0",
    "idb": "~8.0.4",
    "lucide-react": "~1.66.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.1.9",
    "uuid": "~14.0.3",
    "wouter": "~3.13.0",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "~21.2.4",
    "@commitlint/config-conventional": "~21.2.4",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "fake-indexeddb": "~6.2.7",
    "happy-dom": "~21.0.4",
    "lefthook": "~2.2.2",
    "typescript": "~7.0.2",
    "vite": "~8.3.5",
    "vite-plugin-pwa": "~2.0.0",
    "vite-plugin-svgr": "~5.2.0",
    "vitest": "~5.0.5"
